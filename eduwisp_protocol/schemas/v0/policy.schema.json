{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduwisp.org/protocol/v0/policy.schema.json",
  "title": "Policy effettiva / Effective policy",
  "description": "Impostazioni da applicare al dispositivo. Le impostazioni sono indipendenti dalla piattaforma; l'agente segnala quelle che non sa applicare.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "policy_version",
    "settings",
    "poll_interval_seconds"
  ],
  "properties": {
    "protocol_version": {
      "const": "0"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "poll_interval_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera_disabled": {
          "type": "boolean"
        },
        "screen_capture_disabled": {
          "type": "boolean"
        },
        "vpn_config_disabled": {
          "type": "boolean"
        },
        "private_dns_config_disabled": {
          "type": "boolean"
        }
      }
    },
    "family_access": {
      "description": "Presente solo se il dispositivo è affidato a uno studente maggiorenne (ADR-0018): l'agente chiede allo studente se lasciare l'accesso ai familiari. granted: scelta registrata dal server, null se non ancora fatta.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice_requested",
        "granted"
      ],
      "properties": {
        "choice_requested": {
          "const": true
        },
        "granted": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "apps": {
      "description": "App (ADR-0019). allowlist: l'agente sospende le app con icona non presenti in allowed. blocklist: sospende solo quelle in blocked. In entrambi i casi le app in blocked sono sempre sospese (app vietate dalla piattaforma) e le installazioni da fonti sconosciute sono vietate. required: app obbligatorie, che l'agente segnala allo studente finché non sono installate. until: scadenza di uno sblocco temporaneo, rispettata anche offline.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "allowed"
      ],
      "properties": {
        "mode": {
          "enum": [
            "allowlist",
            "blocklist"
          ]
        },
        "allowed": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,254}$"
              },
              "until": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
              },
              "required": {
                "type": "boolean"
              },
              "name": {
                "type": "string",
                "maxLength": 100,
                "description": "Nome da mostrare allo studente (per esempio per le app obbligatorie)."
              },
              "icon": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^https?://",
                "description": "Logo dell'app (PNG o WebP), pubblico."
              },
              "install": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "sha256"
                ],
                "description": "APK da installare in silenzio (ADR-0020): l'agente lo scarica con la propria credenziale, verifica sha256 e lo installa.",
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 500,
                    "pattern": "^https?://"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "blocked": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,254}$"
          }
        },
        "requests": {
          "type": "array",
          "maxItems": 200,
          "description": "Stato delle richieste di app dello studente a cui il tablet è affidato (ADR-0021), le più recenti per ogni app.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,254}$"
              },
              "status": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected"
                ]
              }
            }
          }
        }
      }
    }
  }
}
