{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EduWISP/eduwisp-protocol/schemas/v0/error.schema.json",
  "title": "Errore / Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["invalid_request", "invalid_token", "token_expired", "token_exhausted", "unauthorized", "device_retired", "not_found"] },
        "message": { "type": "string", "maxLength": 500 },
        "details": { "type": "array", "items": { "type": "string" }, "maxItems": 50 }
      }
    }
  }
}
