{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduwisp.org/protocol/v0/status-report.schema.json",
  "title": "Rapporto di stato / Status report",
  "description": "Inviato dall'agente dopo aver applicato una policy e periodicamente. Solo dati tecnici minimi.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "policy_version_applied", "compliant"],
  "properties": {
    "protocol_version": { "const": "0" },
    "policy_version_applied": { "type": "integer", "minimum": 0 },
    "compliant": { "type": "boolean" },
    "non_compliance": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["setting", "reason"],
        "properties": {
          "setting": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "reason": { "enum": ["unsupported", "failed", "pending"] }
        }
      }
    },
    "agent_version": { "type": "string", "maxLength": 32 },
    "os_version": { "type": "string", "maxLength": 32 }
  }
}
