{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduwisp.org/protocol/v0/app-request.schema.json",
  "title": "Richiesta di un'app / App request",
  "description": "Inviata dall'agente quando lo studente chiede di usare un'app sospesa (ADR-0021). Riguarda una sola app: nessun elenco delle app installate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "app"
  ],
  "properties": {
    "protocol_version": {
      "const": "0"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,254}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 300,
      "description": "Motivazione facoltativa scritta dallo studente."
    }
  }
}
